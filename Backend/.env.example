PORT=5000
MONGODB_URI=mongodb://localhost:27017/skillgraph
JWT_SECRET=super_secret_skill_graph_jwt_key_12345
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=super_secret_skill_graph_refresh_key_67890
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_signing_key_13579
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Google Gemini AI Assistant Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# CognoDB (Neo4j) Graph Database Configuration
USE_GRAPH_DB=false
COGNODB_URI=bolt://localhost:7687
COGNODB_USERNAME=neo4j
COGNODB_PASSWORD=password
